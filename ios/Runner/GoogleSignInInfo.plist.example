<!-- Merge into ios/Runner/Info.plist only after replacing the placeholders via a protected build configuration. -->
<key>GIDClientID</key>
<string>$(GOOGLE_IOS_CLIENT_ID)</string>
<key>GIDServerClientID</key>
<string>$(GOOGLE_WEB_CLIENT_ID)</string>
<key>CFBundleURLTypes</key>
<array>
  <dict>
    <key>CFBundleTypeRole</key>
    <string>Editor</string>
    <key>CFBundleURLSchemes</key>
    <array>
      <string>$(GOOGLE_IOS_REVERSED_CLIENT_ID)</string>
    </array>
  </dict>
</array>
